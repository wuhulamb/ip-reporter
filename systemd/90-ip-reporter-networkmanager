#!/bin/sh
# Trigger an immediate report when NetworkManager brings an interface up.
# Installed as /etc/NetworkManager/dispatcher.d/90-ip-reporter when applicable.

case "$2" in
    up|dhcp4-change|dhcp6-change|connectivity-change)
        systemctl start --no-block ip-reporter.service >/dev/null 2>&1
        ;;
esac
exit 0
